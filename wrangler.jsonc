{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "futbolx-chat-cloudflare",
  "main": "src/index.js",
  "compatibility_date": "2026-09-16",

  "durable_objects": {
    "bindings": [
      {
        "name": "CHAT_ROOMS",
        "class_name": "FutbolXChatRoom"
      },
      {
        "name": "USER_REGISTRY",
        "class_name": "FutbolXUserRegistry"
      }
    ]
  },

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "FutbolXChatRoom",
        "FutbolXUserRegistry"
      ]
    }
  ]
}
